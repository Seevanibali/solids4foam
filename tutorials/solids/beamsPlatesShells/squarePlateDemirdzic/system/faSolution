FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Coupled solver
    "w|thetaX|thetaY|theta"
    {
        tolerance       1e-8;
        relTol          1e-8; //0.1;
        maxIter         1000;

        solver          PCG;
        preconditioner  DIC;
    }
}

relaxationFactors
{
    equations
    {
    }

    fields
    {
        // w        0.1;
        // thetaX        0.1;
        // thetaY        0.1;
    }
}

