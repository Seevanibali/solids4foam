FoamFile
{
    version     2.0;
    format      ascii;
    class       areaScalarField;
    location    "0";
    object      thetaX;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// internalField   nonuniform (1 2 3 4 5 6 7 8 9);
internalField    uniform 0;

boundaryField
{
    "right|left|top|bottom"
    {
        // Clamped edge
        type            fixedValue;
        value           uniform 0;
    }

    // "right|left|top|bottom"
    // {
    //     // Simply supported edge
    //     type            zeroGradient;
    // }

    back
    {
         type            empty;
    }

    front
    {
         type            empty;
    }
}

