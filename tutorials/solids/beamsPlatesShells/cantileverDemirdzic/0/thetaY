FoamFile
{
    version     2.0;
    format      ascii;
    class       areaScalarField;
    location    "0";
    object      thetaY;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    left
    {
        // Clamped edge
        type            fixedValue;
        value           uniform 0;
    }

    right
    {
        // Zero Gradient
        /* type            freeEdgeRotationMindlin; */
        type            fixedValue;
        value           uniform 0;
    }

    "back|top|bottom"
    {
        type            empty;
    }

    front
    {
        type            empty;
    }
}

